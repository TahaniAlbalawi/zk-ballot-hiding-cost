pragma solidity ^0.8.20;

import "./ElectionRegistry.sol";

/**
 * @title IVerifier
 * @notice Interface for the Groth16 verifier contract (baseline, 6 public inputs:
 *         root, nullifier, electionId, vote, candidateCount, voter)
 */
interface IVerifier {
    function verifyProof(
        uint256[2] calldata _pA,
        uint256[2][2] calldata _pB,
        uint256[2] calldata _pC,
        uint256[6] calldata _pubSignals
    ) external view returns (bool);
}

/**
 * @title IVerifierPrivate
 * @notice Interface for the commitment vote verifier (6 public inputs:
 *         root, nullifier, electionId, candidateCount, commitment, voter)
 */
interface IVerifierPrivate {
    function verifyProof(
        uint256[2] calldata _pA,
        uint256[2][2] calldata _pB,
        uint256[2] calldata _pC,
        uint256[6] calldata _pubSignals
    ) external view returns (bool);
}

/**
 * @title IPoseidonT3
 * @notice Two-input Poseidon over BN254 as generated by circomlibjs
 *         (poseidonContract.createCode(2)); matches the circuit's commitment hash.
 */
interface IPoseidonT3 {
    function poseidon(uint256[2] memory input) external pure returns (uint256);
}

/**
 * @title BallotBox
 * @notice Accepts and validates ZK-proven votes for both public and private modes
 */
contract BallotBox {
    bytes32 public constant ELECTION_CONFIG_DOMAIN_V1 =
        keccak256("ZK_EVOTING_ELECTION_CONFIG_V1");
    bytes32 public constant TALLY_EVIDENCE_DOMAIN_V1 =
        keccak256("ZK_EVOTING_TALLY_EVIDENCE_V1");

    enum EvidenceWindow {
        UNSPECIFIED,
        PRE_SECRET_RELEASE,
        POST_SECRET_RELEASE
    }

    enum TallyStatus {
        UNPUBLISHED,
        PUBLISHED,
        FINALIZED
    }

    /**
     * @notice Public, version-one evidence tuple for a commitment tally.
     * @dev The contract verifies the declared denominators against its accepted
     *      commitment count and binds the complete tuple to claimedDigest. It
     *      does not prove that actor-supplied manifest contents are truthful.
     */
    struct TallyEvidenceV1 {
        uint256 snapshotBlockNumber;
        bytes32 snapshotBlockHash;
        bytes32 acceptedCommitmentManifestHash;
        bytes32 openingManifestHash;
        uint256 acceptedCommitments;
        uint256 availableOpenings;
        uint256 validOpenings;
        uint256 includedOpenings;
        uint256 missingOpenings;
        uint256 invalidOpenings;
        uint256 extraOpenings;
        EvidenceWindow evidenceWindow;
        bytes32 claimedDigest;
    }

    ElectionRegistry public immutable registry;
    IVerifier public immutable verifier;
    address public immutable configurationAuthority;
    IVerifierPrivate public verifierPrivate;

    // electionId => nullifier => used
    mapping(uint256 => mapping(uint256 => bool)) public nullifierUsed;
    
    // electionId => candidateIndex => voteCount (baseline only)
    mapping(uint256 => mapping(uint16 => uint256)) public voteCounts;
    
    // electionId => total votes cast
    mapping(uint256 => uint256) public totalVotes;

    // electionId => committed-ballot index => vote commitment (Poseidon hash).
    // 'encryptedBallots' is a historical name retained for compatibility; values are hash commitments, not ciphertext.
    mapping(uint256 => mapping(uint256 => uint256)) public encryptedBallots;
    
    // electionId => number of committed ballots
    mapping(uint256 => uint256) public encryptedBallotCount;

    // electionId => tally submitted
    mapping(uint256 => bool) public tallySubmitted;

    // Commitment-result lifecycle and evidence metadata.
    mapping(uint256 => TallyStatus) public tallyStatus;
    mapping(uint256 => uint64) public tallyPublicationVersion;
    mapping(uint256 => bytes32) public tallyEvidenceHash;
    mapping(uint256 => address) public tallyPublisher;
    
    // electionId => candidateIndex => final count (private mode)
    mapping(uint256 => mapping(uint16 => uint256)) public finalTally;

    // On-chain reveal workflow (COMMITMENT_REVEAL elections).
    IPoseidonT3 public commitmentHasher;
    // electionId => word index => bitmap of revealed ballot indices
    mapping(uint256 => mapping(uint256 => uint256)) private _revealedBitmap;
    // electionId => candidateIndex => count of revealed votes
    mapping(uint256 => mapping(uint16 => uint256)) public revealedCounts;
    // electionId => number of revealed ballots
    mapping(uint256 => uint256) public revealedTotal;
    mapping(uint256 => bool) public revealFinalized;

    // === Events ===
    
    event VoteCast(
        uint256 indexed electionId,
        uint256 indexed nullifier,
        uint16 vote,
        address voter,
        bytes32 receiptHash
    );

    // Historical name retained for compatibility; the emitted 'commitment' is a Poseidon hash commitment, not ciphertext.
    event EncryptedVoteCast(
        uint256 indexed electionId,
        uint256 indexed nullifier,
        uint256 commitment,
        address voter,
        bytes32 receiptHash
    );

    event TallySubmitted(
        uint256 indexed electionId,
        uint256[] counts,
        bytes32 inputHash
    );

    event TallyPublished(
        uint256 indexed electionId,
        address indexed publisher,
        uint64 indexed publicationVersion,
        uint256[] counts,
        uint256 resultSum,
        bytes32 evidenceHash,
        uint256 snapshotBlockNumber,
        bytes32 snapshotBlockHash
    );

    event TallyCorrected(
        uint256 indexed electionId,
        address indexed publisher,
        uint64 indexed publicationVersion,
        bytes32 previousEvidenceHash,
        bytes32 evidenceHash,
        uint256[] counts,
        uint256 resultSum
    );

    event TallyFinalized(
        uint256 indexed electionId,
        address indexed publisher,
        uint64 indexed publicationVersion,
        bytes32 evidenceHash
    );

    event PrivateVerifierConfigured(
        address indexed verifier,
        address indexed configurationAuthority
    );

    event CommitmentHasherConfigured(
        address indexed hasher,
        address indexed configurationAuthority
    );

    event VoteRevealed(
        uint256 indexed electionId,
        uint256 indexed ballotIndex,
        uint16 vote,
        address revealer
    );

    event RevealFinalized(
        uint256 indexed electionId,
        uint256[] counts,
        uint256 revealed,
        uint256 unrevealed
    );

    // === Errors ===
    
    error ElectionNotActive();
    error VotingNotOpen();
    error NullifierAlreadyUsed();
    error InvalidVote();
    error InvalidProof();
    error WrongElectionType();
    error VotingStillOpen();
    error InvalidTallyLength();
    error VerifierNotSet();
    error UnauthorizedConfiguration();
    error InvalidVerifierAddress();
    error VerifierAlreadySet();
    error UnauthorizedResultPublisher();
    error InvalidTallyStatus();
    error InvalidTallySum();
    error AcceptedCommitmentCountMismatch();
    error IncompleteOpeningEvidence();
    error InvalidEvidenceManifest();
    error InvalidEvidenceWindow();
    error InvalidSnapshotBinding();
    error AuditDigestMismatch();
    error HasherNotSet();
    error HasherAlreadySet();
    error RevealNotOpen();
    error RevealStillOpen();
    error InvalidRevealBatch();
    error BallotIndexOutOfRange();
    error BallotAlreadyRevealed();
    error OpeningMismatch();
    error RevealAlreadyFinalized();

    constructor(address _registry, address _verifier) {
        registry = ElectionRegistry(_registry);
        verifier = IVerifier(_verifier);
        configurationAuthority = msg.sender;
    }

    /**
     * @notice Set the private verifier once through the deployment authority.
     */
    function setVerifierPrivate(address _verifierPrivate) external {
        if (msg.sender != configurationAuthority) {
            revert UnauthorizedConfiguration();
        }
        if (_verifierPrivate == address(0)) {
            revert InvalidVerifierAddress();
        }
        if (address(verifierPrivate) != address(0)) {
            revert VerifierAlreadySet();
        }
        verifierPrivate = IVerifierPrivate(_verifierPrivate);
        emit PrivateVerifierConfigured(_verifierPrivate, msg.sender);
    }

    /**
     * @notice Set the on-chain commitment hasher once through the deployment authority.
     */
    function setCommitmentHasher(address _hasher) external {
        if (msg.sender != configurationAuthority) {
            revert UnauthorizedConfiguration();
        }
        if (_hasher == address(0)) {
            revert InvalidVerifierAddress();
        }
        if (address(commitmentHasher) != address(0)) {
            revert HasherAlreadySet();
        }
        commitmentHasher = IPoseidonT3(_hasher);
        emit CommitmentHasherConfigured(_hasher, msg.sender);
    }

    /**
     * @notice Cast a vote with ZK proof (BASELINE PUBLIC MODE)
     */
    function castVote(
        uint256 electionId,
        uint256 nullifier,
        uint16 vote,
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c
    ) external {
        // Get election details
        (
            bytes32 root,
            uint16 candidateCount,
            uint64 startTime,
            uint64 endTime,
            bool active
        ) = registry.getElection(electionId);

        // Ensure this is a baseline election
        if (registry.isCommitmentElection(electionId)) {
            revert WrongElectionType();
        }

        // Check election is active and in time window
        if (!active) {
            revert ElectionNotActive();
        }
        if (block.timestamp < startTime || block.timestamp > endTime) {
            revert VotingNotOpen();
        }

        // Check vote is valid
        if (vote >= candidateCount) {
            revert InvalidVote();
        }

        // Check nullifier hasn't been used
        if (nullifierUsed[electionId][nullifier]) {
            revert NullifierAlreadyUsed();
        }

        // Prepare public inputs for verification
        // Order: [root, nullifier, electionId, vote, candidateCount, voter]
        uint256[6] memory publicInputs = [
            uint256(root),
            nullifier,
            electionId,
            uint256(vote),
            uint256(candidateCount),
            uint256(uint160(msg.sender))
        ];

        // Verify the ZK proof
        if (!verifier.verifyProof(a, b, c, publicInputs)) {
            revert InvalidProof();
        }

        // Mark nullifier as used
        nullifierUsed[electionId][nullifier] = true;

        // Increment vote count
        voteCounts[electionId][vote]++;
        totalVotes[electionId]++;

        // Compute receipt hash for auditability
        bytes32 receiptHash = keccak256(abi.encodePacked(nullifier, vote, block.timestamp));

        emit VoteCast(electionId, nullifier, vote, msg.sender, receiptHash);
    }

    /**
     * @notice Cast a committed vote with ZK proof (Private Commitment-Based Mode; the enum name PRIVATE_ENCRYPTED is historical)
     * @param electionId The election ID
     * @param nullifier The voter's nullifier
     * @param commitment The vote commitment Poseidon(vote, randomness) — a hash commitment, not ciphertext
     * @param a Proof element A
     * @param b Proof element B
     * @param c Proof element C
     */
    function castVotePrivate(
        uint256 electionId,
        uint256 nullifier,
        uint256 commitment,
        uint256[2] calldata a,
        uint256[2][2] calldata b,
        uint256[2] calldata c
    ) external {
        if (address(verifierPrivate) == address(0)) {
            revert VerifierNotSet();
        }

        // Get full election details
        (
            bytes32 root,
            uint16 candidateCount,
            uint64 startTime,
            uint64 endTime,
            bool active,
            ElectionRegistry.ElectionType electionType,
        ) = registry.getElectionFull(electionId);

        // Both commitment workflows cast identically; they differ only in how
        // the result is derived after voting closes.
        if (
            electionType != ElectionRegistry.ElectionType.PRIVATE_ENCRYPTED &&
            electionType != ElectionRegistry.ElectionType.COMMITMENT_REVEAL
        ) {
            revert WrongElectionType();
        }

        // Check election is active and in time window
        if (!active) {
            revert ElectionNotActive();
        }
        if (block.timestamp < startTime || block.timestamp > endTime) {
            revert VotingNotOpen();
        }

        // Check nullifier hasn't been used
        if (nullifierUsed[electionId][nullifier]) {
            revert NullifierAlreadyUsed();
        }

        // Prepare public inputs for verification
        // Order: [root, nullifier, electionId, candidateCount, commitment, voter]
        uint256[6] memory publicInputs = [
            uint256(root),
            nullifier,
            electionId,
            uint256(candidateCount),
            commitment,
            uint256(uint160(msg.sender))
        ];

        // Verify the ZK proof
        if (!verifierPrivate.verifyProof(a, b, c, publicInputs)) {
            revert InvalidProof();
        }

        // Mark nullifier as used
        nullifierUsed[electionId][nullifier] = true;

        // Store vote commitment (committed ballot)
        uint256 ballotIndex = encryptedBallotCount[electionId];
        encryptedBallots[electionId][ballotIndex] = commitment;
        encryptedBallotCount[electionId]++;
        totalVotes[electionId]++;

        // Compute receipt hash for auditability
        bytes32 receiptHash = keccak256(abi.encodePacked(nullifier, commitment, block.timestamp));

        emit EncryptedVoteCast(electionId, nullifier, commitment, msg.sender, receiptHash);
    }

    /**
     * @notice Compute the immutable election-configuration identity used by
     *         the version-one tally evidence serialization.
     */
    function computeElectionConfigHash(uint256 electionId) public view returns (bytes32) {
        (
            bytes32 root,
            uint16 candidateCount,
            uint64 startTime,
            uint64 endTime,
            ,
            ElectionRegistry.ElectionType electionType,
            uint64 revealEndTime
        ) = registry.getElectionFull(electionId);

        return keccak256(
            abi.encode(
                ELECTION_CONFIG_DOMAIN_V1,
                address(registry),
                electionId,
                root,
                candidateCount,
                startTime,
                endTime,
                electionType,
                revealEndTime,
                registry.getResultPublisher(electionId)
            )
        );
    }

    /**
     * @notice Recompute the canonical version-one tally evidence digest.
     * @dev Canonical serialization is Solidity abi.encode over the fields in
     *      the exact order below. claimedDigest is deliberately excluded.
     */
    function computeTallyEvidenceHash(
        uint256 electionId,
        uint256[] calldata counts,
        TallyEvidenceV1 calldata evidence,
        address publisher,
        uint64 publicationVersion
    ) public view returns (bytes32) {
        uint256 resultSum = _sumCounts(counts);
        return keccak256(
            abi.encode(
                TALLY_EVIDENCE_DOMAIN_V1,
                block.chainid,
                address(this),
                address(registry),
                electionId,
                computeElectionConfigHash(electionId),
                evidence.snapshotBlockNumber,
                evidence.snapshotBlockHash,
                evidence.acceptedCommitmentManifestHash,
                evidence.openingManifestHash,
                evidence.acceptedCommitments,
                evidence.availableOpenings,
                evidence.validOpenings,
                evidence.includedOpenings,
                evidence.missingOpenings,
                evidence.invalidOpenings,
                evidence.extraOpenings,
                counts,
                resultSum,
                publisher,
                publicationVersion,
                evidence.evidenceWindow
            )
        );
    }

    /**
     * @notice Publish a reconciled tally after the scheduled voting end.
     * @dev Authorization and declared completeness are enforced. The contract
     *      does not prove the distribution represented by actor-supplied
     *      opening manifests; a sum-preserving incorrect vector remains outside
     *      the proof relation and must be addressed by retained evidence.
     */
    function submitTally(
        uint256 electionId,
        uint256[] calldata counts,
        TallyEvidenceV1 calldata evidence
    ) external {
        if (tallyStatus[electionId] != TallyStatus.UNPUBLISHED) {
            revert InvalidTallyStatus();
        }

        (uint16 candidateCount, address publisher) = _publicationContext(electionId);
        uint64 publicationVersion = 1;
        (bytes32 evidenceHash, uint256 resultSum) = _validateTallyEvidence(
            electionId,
            counts,
            evidence,
            publisher,
            publicationVersion,
            candidateCount
        );

        _storeTally(electionId, counts, candidateCount);
        tallySubmitted[electionId] = true;
        tallyStatus[electionId] = TallyStatus.PUBLISHED;
        tallyPublicationVersion[electionId] = publicationVersion;
        tallyEvidenceHash[electionId] = evidenceHash;
        tallyPublisher[electionId] = publisher;

        // Retained for consumers of the original event name. inputHash is now
        // contract-recomputed and validated rather than caller-selected.
        emit TallySubmitted(electionId, counts, evidenceHash);
        emit TallyPublished(
            electionId,
            publisher,
            publicationVersion,
            counts,
            resultSum,
            evidenceHash,
            evidence.snapshotBlockNumber,
            evidence.snapshotBlockHash
        );
    }

    /**
     * @notice Replace a published tally before it is explicitly finalized.
     * @dev This is a publisher-controlled correction state, not a challenge
     *      protocol and not independent evidence of tally correctness.
     */
    function correctTally(
        uint256 electionId,
        uint256[] calldata counts,
        TallyEvidenceV1 calldata evidence
    ) external {
        if (tallyStatus[electionId] != TallyStatus.PUBLISHED) {
            revert InvalidTallyStatus();
        }

        (uint16 candidateCount, address publisher) = _publicationContext(electionId);
        uint64 publicationVersion = tallyPublicationVersion[electionId] + 1;
        (bytes32 evidenceHash, uint256 resultSum) = _validateTallyEvidence(
            electionId,
            counts,
            evidence,
            publisher,
            publicationVersion,
            candidateCount
        );
        bytes32 previousEvidenceHash = tallyEvidenceHash[electionId];

        _storeTally(electionId, counts, candidateCount);
        tallyPublicationVersion[electionId] = publicationVersion;
        tallyEvidenceHash[electionId] = evidenceHash;
        tallyPublisher[electionId] = publisher;

        emit TallyCorrected(
            electionId,
            publisher,
            publicationVersion,
            previousEvidenceHash,
            evidenceHash,
            counts,
            resultSum
        );
    }

    /**
     * @notice Freeze the current published tally against further correction.
     * @dev Finalization records publisher intent and lifecycle state. It is not
     *      a cryptographic statement that the result distribution is correct.
     */
    function finalizeTally(uint256 electionId) external {
        if (tallyStatus[electionId] != TallyStatus.PUBLISHED) {
            revert InvalidTallyStatus();
        }

        (, address publisher) = _publicationContext(electionId);
        tallyStatus[electionId] = TallyStatus.FINALIZED;

        emit TallyFinalized(
            electionId,
            publisher,
            tallyPublicationVersion[electionId],
            tallyEvidenceHash[electionId]
        );
    }

    /**
     * @notice Reveal commitment openings on-chain (COMMITMENT_REVEAL elections).
     * @dev Anyone holding an opening may reveal it after the scheduled end of
     *      voting and until the reveal deadline. Each opening is checked against
     *      the stored commitment, so the derived counts are publicly verifiable;
     *      commitments that are never revealed stay visible as a gap between
     *      accepted and revealed ballots. A batch reverts as a whole if any
     *      item is invalid.
     */
    function revealVotes(
        uint256 electionId,
        uint256[] calldata ballotIndices,
        uint16[] calldata votes,
        uint256[] calldata randomness
    ) external {
        (uint16 candidateCount, uint64 endTime, uint64 revealEndTime) = _revealContext(electionId);
        if (block.timestamp <= endTime || block.timestamp > revealEndTime) {
            revert RevealNotOpen();
        }
        uint256 batchSize = ballotIndices.length;
        if (batchSize == 0 || votes.length != batchSize || randomness.length != batchSize) {
            revert InvalidRevealBatch();
        }
        if (address(commitmentHasher) == address(0)) {
            revert HasherNotSet();
        }

        uint256 acceptedCommitments = encryptedBallotCount[electionId];
        for (uint256 i = 0; i < batchSize; i++) {
            uint256 ballotIndex = ballotIndices[i];
            uint16 vote = votes[i];
            if (ballotIndex >= acceptedCommitments) {
                revert BallotIndexOutOfRange();
            }
            if (vote >= candidateCount) {
                revert InvalidVote();
            }

            uint256 word = ballotIndex >> 8;
            uint256 bit = uint256(1) << (ballotIndex & 0xff);
            uint256 revealedBits = _revealedBitmap[electionId][word];
            if (revealedBits & bit != 0) {
                revert BallotAlreadyRevealed();
            }
            if (
                commitmentHasher.poseidon([uint256(vote), randomness[i]]) !=
                encryptedBallots[electionId][ballotIndex]
            ) {
                revert OpeningMismatch();
            }

            _revealedBitmap[electionId][word] = revealedBits | bit;
            revealedCounts[electionId][vote]++;
            emit VoteRevealed(electionId, ballotIndex, vote, msg.sender);
        }
        revealedTotal[electionId] += batchSize;
    }

    /**
     * @notice Freeze a COMMITMENT_REVEAL result after the reveal deadline.
     * @dev Anyone may finalize. The result is the on-chain revealed counts; the
     *      number of commitments that were never revealed is published with it.
     */
    function finalizeReveal(uint256 electionId) external {
        (uint16 candidateCount, , uint64 revealEndTime) = _revealContext(electionId);
        if (block.timestamp <= revealEndTime) {
            revert RevealStillOpen();
        }
        if (revealFinalized[electionId]) {
            revert RevealAlreadyFinalized();
        }
        revealFinalized[electionId] = true;

        uint256[] memory counts = new uint256[](candidateCount);
        for (uint16 i = 0; i < candidateCount; i++) {
            counts[i] = revealedCounts[electionId][i];
        }
        uint256 revealed = revealedTotal[electionId];
        emit RevealFinalized(electionId, counts, revealed, encryptedBallotCount[electionId] - revealed);
    }

    /**
     * @notice Check whether a committed ballot has been revealed on-chain.
     */
    function isBallotRevealed(uint256 electionId, uint256 ballotIndex) external view returns (bool) {
        return _revealedBitmap[electionId][ballotIndex >> 8] & (uint256(1) << (ballotIndex & 0xff)) != 0;
    }

    function _revealContext(uint256 electionId)
        internal
        view
        returns (uint16 candidateCount, uint64 endTime, uint64 revealEndTime)
    {
        ElectionRegistry.ElectionType electionType;
        (, candidateCount, , endTime, , electionType, revealEndTime) = registry.getElectionFull(electionId);
        if (electionType != ElectionRegistry.ElectionType.COMMITMENT_REVEAL) {
            revert WrongElectionType();
        }
    }

    function _publicationContext(uint256 electionId)
        internal
        view
        returns (uint16 candidateCount, address publisher)
    {
        uint64 endTime;
        ElectionRegistry.ElectionType electionType;
        (
            ,
            candidateCount,
            ,
            endTime,
            ,
            electionType,
        ) = registry.getElectionFull(electionId);

        if (electionType != ElectionRegistry.ElectionType.PRIVATE_ENCRYPTED) {
            revert WrongElectionType();
        }
        // Deactivation stops further ballots but never shortens the scheduled
        // release boundary for commitment results.
        if (block.timestamp <= endTime) {
            revert VotingStillOpen();
        }

        publisher = registry.getResultPublisher(electionId);
        if (msg.sender != publisher) {
            revert UnauthorizedResultPublisher();
        }
    }

    function _validateTallyEvidence(
        uint256 electionId,
        uint256[] calldata counts,
        TallyEvidenceV1 calldata evidence,
        address publisher,
        uint64 publicationVersion,
        uint16 candidateCount
    ) internal view returns (bytes32 evidenceHash, uint256 resultSum) {
        if (counts.length != candidateCount) {
            revert InvalidTallyLength();
        }

        uint256 acceptedCommitments = encryptedBallotCount[electionId];
        resultSum = _sumCounts(counts);
        if (resultSum != acceptedCommitments) {
            revert InvalidTallySum();
        }
        if (evidence.acceptedCommitments != acceptedCommitments) {
            revert AcceptedCommitmentCountMismatch();
        }
        if (
            evidence.availableOpenings != acceptedCommitments ||
            evidence.validOpenings != acceptedCommitments ||
            evidence.includedOpenings != acceptedCommitments ||
            evidence.missingOpenings != 0 ||
            evidence.invalidOpenings != 0 ||
            evidence.extraOpenings != 0
        ) {
            revert IncompleteOpeningEvidence();
        }
        if (
            evidence.acceptedCommitmentManifestHash == bytes32(0) ||
            evidence.openingManifestHash == bytes32(0)
        ) {
            revert InvalidEvidenceManifest();
        }
        // The supplied hash is part of the public evidence package. We require
        // a prior block and a nonzero hash, but do not claim on-chain validation
        // of arbitrary historical block hashes (which has a 256-block limit).
        if (
            evidence.snapshotBlockNumber >= block.number ||
            evidence.snapshotBlockHash == bytes32(0)
        ) {
            revert InvalidSnapshotBinding();
        }
        if (evidence.evidenceWindow != EvidenceWindow.POST_SECRET_RELEASE) {
            revert InvalidEvidenceWindow();
        }

        evidenceHash = computeTallyEvidenceHash(
            electionId,
            counts,
            evidence,
            publisher,
            publicationVersion
        );
        if (evidence.claimedDigest != evidenceHash) {
            revert AuditDigestMismatch();
        }
    }

    function _storeTally(
        uint256 electionId,
        uint256[] calldata counts,
        uint16 candidateCount
    ) internal {
        for (uint16 i = 0; i < candidateCount; i++) {
            finalTally[electionId][i] = counts[i];
        }
    }

    function _sumCounts(uint256[] calldata counts) internal pure returns (uint256 sum) {
        for (uint256 i = 0; i < counts.length; i++) {
            sum += counts[i];
        }
    }

    /**
     * @notice Get the vote counts for all candidates in an election
     */
    function getResults(uint256 electionId) 
        external 
        view 
        returns (uint256[] memory counts) 
    {
        (, uint16 candidateCount, , , , ElectionRegistry.ElectionType electionType, ) =
            registry.getElectionFull(electionId);

        counts = new uint256[](candidateCount);

        // For private elections, return the latest published tally. Callers
        // must inspect tallyStatus to distinguish PUBLISHED from FINALIZED.
        if (electionType == ElectionRegistry.ElectionType.PRIVATE_ENCRYPTED) {
            if (tallySubmitted[electionId]) {
                for (uint16 i = 0; i < candidateCount; i++) {
                    counts[i] = finalTally[electionId][i];
                }
            }
            // Otherwise return zeros (tally not yet published)
        } else if (electionType == ElectionRegistry.ElectionType.COMMITMENT_REVEAL) {
            // Reveal: counts of openings checked on-chain so far. Callers must
            // inspect revealFinalized and the unrevealed gap.
            for (uint16 i = 0; i < candidateCount; i++) {
                counts[i] = revealedCounts[electionId][i];
            }
        } else {
            // Baseline: return live counts
            for (uint16 i = 0; i < candidateCount; i++) {
                counts[i] = voteCounts[electionId][i];
            }
        }
    }

    /**
     * @notice Check if a nullifier has been used
     */
    function isNullifierUsed(uint256 electionId, uint256 nullifier) 
        external 
        view 
        returns (bool used) 
    {
        return nullifierUsed[electionId][nullifier];
    }

    /**
     * @notice Get committed ballot (vote commitment) by index
     */
    function getEncryptedBallot(uint256 electionId, uint256 index) 
        external 
        view 
        returns (uint256 commitment) 
    {
        return encryptedBallots[electionId][index];
    }
}
